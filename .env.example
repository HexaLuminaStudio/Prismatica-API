# =====================================================================
# Prismatica 后端 .env.example
# 复制为 .env 后填入实际值;生产严禁使用默认占位密钥。
# =====================================================================

# 应用
APP_NAME=prismatica-backend
ENV=dev
DEBUG=false
HOST=0.0.0.0
PORT=8000

# MySQL(对齐 docker-compose 服务名)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prismatica
DB_USER=prismatica
DB_PASSWORD=prismatica-change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis(限流)
REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1

# HMAC 凭证签名(与客户端 LICENSE_SECRET 保持一致)
LICENSE_SECRET=please-generate-64-hex-and-share-with-client

# JWT
JWT_SECRET=please-generate-different-64-hex
JWT_ALG=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Admin
ADMIN_TOKEN=please-generate-strong-random

# 限流
RATE_LIMIT_PER_MIN=60

# 日志
LOG_LEVEL=INFO
LOG_JSON=false

# 自动建表(开发期 true,生产 false)
AUTO_INIT_SCHEMA=true

# CORS(跨域)—— 留空允许所有(仅 dev);生产必须显式列出
# 多项用英文逗号分隔,例如:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SEC=600