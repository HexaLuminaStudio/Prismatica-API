# =====================================================================
# Prismatica 后端 .env.example
# 复制为 .env 后填入实际值;生产严禁使用默认占位密钥。
# =====================================================================

# 应用
APP_NAME=prismatica-backend
APP_VERSION=2026.08.07-p0b
BUILD_ID=local
GIT_COMMIT=unknown
ENV=dev
DEBUG=false
HOST=0.0.0.0
PORT=8000

# MySQL(对齐 docker-compose 服务名)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prismatica
DB_USER=prismatica
DB_PASSWORD=prismatica-change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis(限流)
REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1

# HMAC 凭证签名(与客户端 LICENSE_SECRET 保持一致)
LICENSE_SECRET=please-generate-64-hex-and-share-with-client

# JWT
JWT_SECRET=please-generate-different-64-hex
JWT_ALG=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# 受保护的 HSK 作文数据库资源
# - 两个 SOURCE_URL 只允许配置在后端，禁止写入桌面客户端或提交真实地址
# - RESOURCE_PUBLIC_BASE_URL 填用户可访问的 HTTPS API 根地址，不带末尾 /
# - RESOURCE_TICKET_SECRET 必须独立生成，不能与 JWT_SECRET / LICENSE_SECRET 相同
RESOURCE_TICKET_SECRET=please-generate-another-64-hex
RESOURCE_TICKET_TTL_SEC=180
RESOURCE_PUBLIC_BASE_URL=https://api.example.com
RESOURCE_UPSTREAM_CONNECT_TIMEOUT_SEC=10
RESOURCE_UPSTREAM_READ_TIMEOUT_SEC=60
HSK_CORPUS_SOURCE_URL=
HSK_CORPUS_SHA256=
HSK_CORPUS_VERSION=1
HSK_LOCAL_CORPUS_SOURCE_URL=
HSK_LOCAL_CORPUS_SHA256=
HSK_LOCAL_CORPUS_VERSION=1

# 启动引导中的“使用官方账号”功能
# - 账号密码只能配置在 PrismaticaAPI 的生产环境，禁止提交真实值
# - 桌面客户端只会收到登录后签发的 Token，不会收到账号密码
OFFICIAL_HSK_USERNAME=
OFFICIAL_HSK_PASSWORD=
OFFICIAL_GLOBAL_USERNAME=
OFFICIAL_GLOBAL_PASSWORD=
OFFICIAL_TOKEN_CONNECT_TIMEOUT_SEC=10
OFFICIAL_TOKEN_READ_TIMEOUT_SEC=30

# 平台 AI（密钥只能部署在后端，禁止写入桌面客户端）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_CHAT=deepseek-chat
AI_CONNECT_TIMEOUT_SEC=10
AI_READ_TIMEOUT_SEC=120
AI_MAX_OUTPUT_TOKENS=2048

# Admin(2026-08-05 M2:管理后台登录)
# - ADMIN_TOKEN:CLI / curl 仍可用 X-Admin-Token 头;cookie 登录后用 cookie
# - ADMIN_COOKIE_SECRET:cookie HMAC 签名密钥(至少 32 字节)
# - ADMIN_COOKIE_MAX_AGE:cookie 有效期(秒),默认 2h
# - ADMIN_BOOTSTRAP_PASSWORD:启动期 seed root 账号的初始密码;
#   留空 → 自动生成 24 字节随机密码并打印到 stderr(请立即修改并保存)
# - ADMIN_MAX_FAILED_ATTEMPTS:连续登录失败 N 次后锁定账号
ADMIN_TOKEN=please-generate-strong-random
ADMIN_COOKIE_SECRET=please-generate-32-byte-random-for-cookie-sign
ADMIN_COOKIE_MAX_AGE=7200
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_MAX_FAILED_ATTEMPTS=5

# 限流
RATE_LIMIT_PER_MIN=60

# 日志
LOG_LEVEL=INFO
LOG_JSON=false

# schema 只允许通过版本化迁移工具修改；保持 false
AUTO_INIT_SCHEMA=false

# scripts/import_schema.py 另有写操作保险：仅在单次进程环境中显式设置
# ALLOW_SCHEMA_IMPORT=true 才会执行；不要把该开关长期写入 .env。

# CORS(跨域)—— 留空允许所有(仅 dev);生产必须显式列出
# 多项用英文逗号分隔,例如:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# 跨端口部署(前端与后端同 IP 不同端口)推荐配置:
#   CORS_ALLOWED_ORIGINS=http://103.236.55.211:8080
#   CORS_ALLOW_CREDENTIALS=true
#   ADMIN_COOKIE_SECURE=true
# 注意:supports_credentials=true 时 CORS_ALLOWED_ORIGINS 不能用 "*"
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SEC=600
